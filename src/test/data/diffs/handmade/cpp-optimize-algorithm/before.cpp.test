#include <vector>
#include <algorithm>

int findMin(const std::vector<int>& vec) {
    if (vec.empty()) return 0;
    int min = vec[0];
    for (size_t i = 1; i < vec.size(); i++) {
        if (vec[i] < min) {
            min = vec[i];
        }
    }
    return min;
}

int main() {
    std::vector<int> numbers = {5, 2, 8, 1, 9};
    return findMin(numbers);
}
