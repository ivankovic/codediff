use std::collections::HashSet;

fn find_duplicate(nums: &[i32]) -> Option<i32> {
    // HashSet approach - O(n) time complexity
    let mut seen = HashSet::new();
    
    for &num in nums {
        if seen.contains(&num) {
            return Some(num);
        }
        seen.insert(num);
    }
    
    None
}

fn main() {
    let nums = vec![1, 3, 4, 2, 2];
    if let Some(dup) = find_duplicate(&nums) {
        println!("Duplicate found: {}", dup);
    } else {
        println!("No duplicate found");
    }
}