function fetchData() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            try {
                resolve("data");
            } catch (error) {
                reject(error);
            }
        }, 1000);
    });
}

fetchData()
    .then((data) => {
        console.log(data);
    })
    .catch((error) => {
        console.error("Error:", error);
    });
